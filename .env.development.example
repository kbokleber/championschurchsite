# ==================================================
# VARIÁVEIS DE AMBIENTE - DESENVOLVIMENTO
# ==================================================
# Copie para .env.development e preencha os valores

# ==================================================
# DJANGO SETTINGS
# ==================================================
DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Dev local no Windows: use SQLite (Postgres do Coolify não resolve fora do Docker).
# Copie estas linhas para backend/.env — o import de backup prod usa database.json no SQLite.
CHURCH_USE_SQLITE=1

# ==================================================
# POSTGRESQL DATABASE (Coolify ou servidor remoto)
# ==================================================
# Formato: postgres://user:password@host:port/database
POSTGRES_HOST=sc8kgkocw04gc80ockko4ks4
POSTGRES_PORT=5432
POSTGRES_DB=championschurch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here

# ==================================================
# CORS SETTINGS
# ==================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://127.0.0.1:5173
