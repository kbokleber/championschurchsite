# ==================================================
# VARIÁVEIS DE AMBIENTE - CHAMPIONS CHURCH
# ==================================================
# Copie este arquivo para .env e preencha os valores

# ==================================================
# DJANGO SETTINGS
# ==================================================
DJANGO_ENVIRONMENT=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production-min-50-chars
DJANGO_ALLOWED_HOSTS=championschurch.com.br,www.championschurch.com.br,localhost

# ==================================================
# POSTGRESQL DATABASE
# ==================================================
# Host do PostgreSQL (nome do serviço ou IP na rede Docker)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=championschurch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here

# ==================================================
# CORS SETTINGS
# ==================================================
CORS_ALLOWED_ORIGINS=https://championschurch.com.br,https://www.championschurch.com.br

# ==================================================
# DOCKER NETWORKS
# ==================================================
# Nome da rede externa do Nginx
NGINX_NETWORK_NAME=nginx_network

# Nome da rede externa do PostgreSQL
POSTGRES_NETWORK_NAME=postgres_network
